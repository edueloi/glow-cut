# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL do sistema logado (login, dashboard admin/profissional/super-admin).
# Usado em links de login, reset de senha, checkout do Stripe e portal de assinatura.
APP_URL="https://app.agendelle.com.br"

# PUBLIC_SITE_URL: URL do site público (landing, blog, agendamento do cliente).
# Usado no link de agendamento enviado por e-mail e no rodapé dos e-mails.
PUBLIC_SITE_URL="https://agendelle.com.br"

# ── Email SMTP ────────────────────────────────────────────────────────────────
SMTP_HOST="mail.develoi.com.br"
SMTP_PORT="465"
SMTP_USER="agendelle@develoi.com.br"
SMTP_PASS="SUA_SENHA_SMTP"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Eventos necessários no webhook: checkout.session.completed, checkout.session.expired,
# customer.subscription.updated, customer.subscription.deleted,
# invoice.payment_succeeded, invoice.payment_failed

# ── NFS-e (Nota Fiscal de Serviço eletrônica) ─────────────────────────────────
# Chave usada para criptografar (AES-256-CBC) a senha do certificado digital A1 (.pfx)
# de cada salão antes de gravar no banco. SEM fallback hardcoded — se não configurada,
# o upload/emissão falha alto de propósito, em vez de rodar com uma chave fraca conhecida.
# Gere com: openssl rand -base64 32 (ou qualquer string aleatória de 32+ caracteres).
NFSE_ENCRYPTION_KEY="GERE_UMA_CHAVE_ALEATORIA_DE_32_CARACTERES"
